{
  "expo": {
    "name": "ReadyNow",
    "slug": "alert-button-expo",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.innovationlab.alertbuttonexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "com.innovationlab.alertbuttonexpo",
      "supportsTablet": true,
      "jsEngine": "jsc",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We need your location to help you find legal support in the event you are detained.",
        "NSUserNotificationsUsageDescription": "ReadyNow uses notifications to deliver urgent security alerts.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "sunglow-camel-3009.twil.io": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "hrf-alt-dev.us.auth0.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "readynow-4264.twil.io": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "readynow-4264-dev.twil.io": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.innovationlab.alertbuttonexpo",
      "googleServicesFile": "./app/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "myapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "hrf-alt-dev.us.auth0.com",
              "pathPrefix": "/android/com.innovationlab.alertbuttonexpo/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ReadyNow to use Face ID."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ReadyNow needs access to your contacts so you can quickly add emergency contacts from your phone."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "./auth0-config-plugin",
      "./network-security-config-plugin",
      "./android-manifest-security-plugin",
      "./proguard-security-plugin",
      "./android-stack-protection-plugin",
      "./android-app-links-plugin",
      "./android-backup-security-plugin",
      "./ios-backup-security-plugin",
      "./android-strandhogg-protection-plugin",
      "./android-permissions-plugin",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "readynow",
          "organization": "human-rights-first"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c3687fcd-a366-4c15-b25d-52d091cce497"
      }
    },
    "owner": "hrfinnovationlab"
  }
}
