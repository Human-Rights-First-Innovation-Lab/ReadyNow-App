{
  "name": "readynow",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:coverage": "jest --ci --runInBand --forceExit --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=json --coverageReporters=html --coverageReporters=text-summary && node scripts/generate-coverage-summary.js",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "coverage:compare": "node scripts/coverage-compare.js",
    "coverage:update-baseline": "node scripts/update-coverage-baseline.js",
    "lint": "expo lint",
    "eas-build-pre-install": "if [ -n \"$GOOGLE_SERVICES_JSON\" ]; then cp \"$GOOGLE_SERVICES_JSON\" app/google-services.json; fi"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    ],
    "setupFilesAfterEnv": [
      "./jest-setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|@sentry/.*|native-base|react-native-svg|uuid)"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/__mocks__/styleMock.js"
    },
    "collectCoverageFrom": [
      "app/**/*.{js,jsx,ts,tsx}",
      "!app/**/*.d.ts",
      "!app/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json",
      "html",
      "text-summary"
    ]
  },
  "dependencies": {
    "@bacons/text-decoder": "^0.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^1.3.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "^7.2.0",
    "@tanstack/react-query": "^5.71.1",
    "@trpc/client": "^11.8.0",
    "@trpc/react-query": "^11.8.0",
    "@trpc/server": "^11.8.0",
    "base-64": "^1.0.0",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "metro": "^0.83.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-auth0": "^4.6.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "superjson": "^2.2.2",
    "twilio": "^5.5.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@octokit/rest": "^20.0.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^18.3.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.26.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "nativewind": "^2.0.11",
    "postcss": "^8.4.23",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "shell-quote": "^1.10.0"
  },
  "private": true
}
